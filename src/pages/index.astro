---
import Layout from "../pages/Layout.astro"
import Nav from "../components/navBar.astro"
import Foot from "../components/foot.astro"
import Banner from "../components/banner.astro"
import Carousel from "../components/carousel.astro"
import Qtcomp from "../components/qtecomp.astro"

import '../styles/global.css';
---

<Layout>
	<Nav />
	<Banner />
	<Carousel />
	<Qtcomp
		title="1. How long does standard laundry processing usually take?"
		description="Most orders take 24 to 48 hours. Rush same-day service is usually available for an extra fee."
		imageSrc="/images/qmark.png"
		imageAlt="Postpartum support"
		imagePosition="left"
		bground="bg-seco"
	/>
	<Qtcomp
		title="2. Do customers need to separate lights and darks before pickup?"
		description="No, staff automatically sort clothes by color and fabric type. You only need to bag delicate items separately."
		imageSrc="/images/excmrk.png"
		imageAlt="Postpartum support"
		imagePosition="right"
		bground="bg-tert"
	/>
	<Qtcomp
		title="3. How are lost or damaged garments handled?"
		description="Items are tracked and inspected during intake. If damage occurs, the service reimburses you per their policy terms."
		imageSrc="/images/spk.png"
		imageAlt="Postpartum support"
		imagePosition="left"
		bground="bg-seco"
	/>
	<Foot />
</Layout>