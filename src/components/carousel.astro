<style>
    .crs {
        width: max-content;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .crs::-webkit-scrollbar {
        display: none;
    }

    .grp {
        animation: spin 24s infinite linear;
    }

    @keyframes spin {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }
</style>